rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function temPapelPainel() {
      return request.auth != null &&
        (request.auth.token.papel == 'fundadora' || request.auth.token.papel == 'suporte');
    }

    function papelPainelEh(papel) {
      return request.auth != null && request.auth.token.papel == papel;
    }

    function camposPermitidosSuporte() {
      let permitidos = ['status_licenca', 'data_expiracao', 'observacoes', 'atualizado_em', 'atualizado_por'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(permitidos);
    }

    function ehDonoDaConta() {
      return request.auth != null && request.auth.token.email == resource.data.email_responsavel;
    }

    match /contas/{contaId} {
      allow read: if temPapelPainel() || ehDonoDaConta();
      allow create, delete: if papelPainelEh('fundadora');
      allow update: if papelPainelEh('fundadora')
        || (papelPainelEh('suporte') && camposPermitidosSuporte());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}